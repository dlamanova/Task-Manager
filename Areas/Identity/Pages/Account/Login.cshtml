@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null; // Disable the shared layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Task Manager</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #a3d5c3; /* Background color */
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-container {
            text-align: center;
            color: #333;
        }

        .login-box {
            background-color: #dcebe9; /* Form background color */
            border-radius: 10px;
            padding: 20px 30px;
            width: 400px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .role-switch {
            display: flex;
            justify-content: center;
            margin-bottom: 15px;
        }

        .role-btn {
            background-color: #83c2af; /* Button color */
            border: none;
            padding: 10px 20px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            border-radius: 5px;
            margin: 0 5px;
        }

            .role-btn:hover {
                background-color: #5aa899; /* Darker color on hover */
                transform: scale(1.05); /* Slight enlargement on hover */
            }

            .role-btn:active {
                background-color: #46917a; /* Color on click */
                transform: scale(0.95); /* Slight reduction on click */
            }

            .role-btn.active {
                background-color: #46917a; /* Highlight active role */
            }

        .input-field {
            display: block;
            width: 100%;
            margin: 10px 0;
            padding: 10px;
            border: 1px solid #83c2af; /* Border color */
            border-radius: 5px;
            box-sizing: border-box;
        }

        .login-btn {
            background-color: #83c2af; /* Login button color */
            color: white;
            padding: 10px;
            border: none;
            width: 100%;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-top: 10px;
        }

            .login-btn:hover {
                background-color: #5aa899;
            }

        .text-danger {
            color: red;
        }
    </style>
    <script>
        function setRole(role, button) {
            // Set the selected role in the hidden input field
            document.getElementById('roleInput').value = role;

            // Remove 'active' class from all buttons
            const buttons = document.querySelectorAll('.role-btn');
            buttons.forEach(btn => btn.classList.remove('active'));

            // Add 'active' class to the clicked button
            button.classList.add('active');
        }
    </script>
</head>
<body>
    <div class="login-container">
        <h1>WELCOME TO TASK MANAGER</h1>
        <div class="login-box">
            <!-- Role Selection Buttons -->
            <div class="role-switch">
                <button type="button" class="role-btn active" onclick="setRole('RegularUser', this)">User</button>
                <button type="button" class="role-btn" onclick="setRole('Administrator', this)">Admin</button>
            </div>

            <!-- Login Form -->
            <form id="account" method="post">
                <!-- Hidden Field for Selected Role -->
                <input type="hidden" id="roleInput" asp-for="Input.Role" value="RegularUser" />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input asp-for="Input.Email" class="input-field" autocomplete="username" placeholder="Email" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <input asp-for="Input.Password" class="input-field" autocomplete="current-password" placeholder="Password" required />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                <button type="submit" class="login-btn">Login</button>
            </form>
            <p>
                <a asp-page="./Register">Do not have an account? Register</a>
            </p>
        </div>
    </div>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
